<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The secrets store (Hacker News session) is encrypted with a Keystore key that never leaves the device, so it can't be restored elsewhere. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
